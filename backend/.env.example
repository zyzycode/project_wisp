# Copy to backend/.env; never commit actual keys. Restart after changes.
# Process environment overrides this file. Blank optional values use defaults.
# Supported providers: groq, gemini, openai. Only the selected key is used.
WISP_AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Existing token_api remains a fallback only for Groq.

# Blank model selects the provider default:
# groq: openai/gpt-oss-20b; gemini: gemini-3.5-flash-lite (or gemini-3.8-flash).
# openai: gpt-4.1-mini by default; gpt-6-astra for flagship testing.
# Both use Chat Completions, JSON mode and store=false.
WISP_AI_MODEL=
# Blank URL selects the official endpoint. A custom endpoint receives your key/context.
# groq: https://api.groq.com/openai/v1/
# gemini: https://generativelanguage.googleapis.com/v1beta/
# openai: https://api.openai.com/v1/
# HTTPS required, except loopback HTTP; no userinfo, query or fragment.
WISP_AI_BASE_URL=

# Output integer 1..4096 (default 4096); events additionally cap output at 1024.
WISP_AI_MAX_OUTPUT_TOKENS=
# Temperature 0..2; blank leaves the provider default. Must be blank for GPT-6 Astra.
WISP_AI_TEMPERATURE=
# Gemini only: minimal/low/medium/high. Flash 3.8 does not support minimal.
# Blank selects minimal for Flash-Lite, low for Flash; leave blank for Groq/OpenAI.
# GPT-6 Astra uses a server-owned reasoning_effort=low preset.
WISP_AI_THINKING_LEVEL=

# Timeouts in seconds: request (0,10], connect/pool (0,3]. Defaults 10/3/3.
WISP_AI_REQUEST_TIMEOUT=
WISP_AI_CONNECT_TIMEOUT=
WISP_AI_POOL_TIMEOUT=
# Set true only to deliberately use proxy/TLS environment configuration.
WISP_UPSTREAM_TRUST_ENV=false

# Optional server ledger location; blank keeps the default path.
WISP_LEDGER_PATH=
# Legacy ASSISTANTS_JSON remains supported; conflicting explicit fields are rejected.
