{
  "name": "project_wisp",
  "version": "0.2.0",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:win:portable": "npm run build && electron-builder --win portable --x64",
    "test": "vitest run",
    "test:python": "python3 -m unittest discover -s scripts/tests -p 'test_*.py'",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "sprites:process": "python3 scripts/process_sprites.py",
    "sprites:validate": "python3 scripts/validate_manifest.py --check",
    "sprites:update": "python3 scripts/validate_manifest.py --write",
    "sprites:sync": "python3 scripts/validate_manifest.py --write",
    "clean": "rimraf dist dist-electron"
  },
  "build": {
    "appId": "com.projectwisp.app",
    "productName": "Project Wisp",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/index.html",
      "dist/assets/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "keywords": [
    "desktop-pet",
    "ai-companion",
    "electron",
    "react",
    "typescript"
  ],
  "author": "Project Wisp Team",
  "license": "MIT",
  "description": "Cross-platform Desktop AI Companion",
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
