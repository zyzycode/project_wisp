{
  "name": "@wisp/frontend",
  "version": "0.3.0",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "smoke:desktop": "node scripts/smoke.mjs",
    "build": "npm run typecheck && vite build",
    "build:win:portable": "npm run build && electron-builder --win portable --x64",
    "test": "vitest run --config vitest.config.mjs --configLoader native",
    "test:python": "python -m unittest discover -s scripts/tests -p \"test_*.py\"",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "sprites:process": "python3 asset-pipeline/scripts/process_sprites.py",
    "sprites:preview": "python3 asset-pipeline/scripts/preview_sprites.py",
    "sprites:validate": "python scripts/validate_manifest.py --check",
    "sprites:update": "python scripts/validate_manifest.py --write",
    "sprites:sync": "python scripts/validate_manifest.py --write",
    "clean": "rimraf dist dist-electron"
  },
  "build": {
    "appId": "com.projectwisp.app",
    "productName": "Project Wisp",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/index.html",
      "dist/assets/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/onnxruntime-node/**/*",
      "node_modules/sharp/**/*",
      "node_modules/@img/**/*"
    ],
    "mac": {
      "entitlements": "packaging/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Wisp uses the microphone while voice input is enabled. Speech is recognized locally on this device."
      }
    },
    "extraResources": [
      {
        "from": ".cache/voice-models/1846881b6b3a3024392c1eea3ad983695bc23925",
        "to": "voice-models/1846881b6b3a3024392c1eea3ad983695bc23925",
        "filter": [
          "config.json",
          "generation_config.json",
          "preprocessor_config.json",
          "tokenizer.json",
          "tokenizer_config.json",
          "onnx/decoder_model_merged_quantized.onnx",
          "onnx/encoder_model_quantized.onnx"
        ]
      },
      {
        "from": ".cache/voice-models/18b0bf898d211718bc33082fadc36a448e0cbc0c",
        "to": "voice-models/18b0bf898d211718bc33082fadc36a448e0cbc0c",
        "filter": [
          "cpu_int4/code_predictor.onnx",
          "cpu_int4/codec_embed.onnx",
          "cpu_int4/residual_embed.onnx",
          "cpu_int4/talker_cache.onnx",
          "cpu_int4/text_embed.onnx",
          "cpu_int4/tok_decoder.onnx"
        ]
      },
      {
        "from": ".cache/voice-models/85e237c12c027371202489a0ec509ded67b5e4b5",
        "to": "voice-models/85e237c12c027371202489a0ec509ded67b5e4b5",
        "filter": [
          "config.json",
          "tokenizer_config.json",
          "vocab.json",
          "merges.txt"
        ]
      }
    ]
  },
  "keywords": [
    "desktop-pet",
    "ai-companion",
    "electron",
    "react",
    "typescript"
  ],
  "author": "Project Wisp Team",
  "license": "MIT",
  "description": "Cross-platform Desktop AI Companion",
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-electron": "^1.1.1",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "better-sqlite3": "13.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
